# Build context for packages/tcip-web/Dockerfile is the repo root; this Dockerfile-specific ignore file (read by
# BuildKit beside the Dockerfile, never at the root, where a root .dockerignore also hides tests/ from code indexers) trims it to what a build stage COPYs.
.git/
.claude/
.tcip/
docs/
tests/
tcip-projects/
data/
references/pdf/
.review-corpus/

**/__pycache__/
**/*.pyc
**/*.egg-info/
dist/
build/
*.whl
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

node_modules/
packages/tcip-web/frontend/node_modules/
packages/tcip-web/frontend/dist/
packages/tcip-web/static/

*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
*.log
tensorboard_runs/
