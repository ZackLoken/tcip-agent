{
  "permissions": {
    "deny": [
      "Edit(packages/**)",
      "Edit(tests/**)",
      "Edit(.github/**)",
      "Edit(scripts/**)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(.mcp.json)",
      "Edit(pyproject.toml)",
      "Edit(package.json)",
      "Edit(tsconfig.json)",
      "Edit(.gitignore)",
      "Edit(README.md)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)"
    ],
    "allow": [
      "mcp__tcip__*",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Get-Item:*)",
      "PowerShell(Get-Location)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(Get-Process:*)",
      "PowerShell(Get-NetTCPConnection:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python packages/tcip-web/src/tcip_web/agent_bash_guard.py"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python packages/tcip-web/src/tcip_web/agent_powershell_guard.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python packages/tcip-web/src/tcip_web/agent_learning_capture.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python packages/tcip-web/src/tcip_web/agent_session_start.py"
          }
        ]
      }
    ]
  }
}