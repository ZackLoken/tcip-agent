{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch TCIP Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/tcip-vscode",
        "${workspaceFolder}/tcip-agent.code-workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/tcip-vscode/out/**/*.js"
      ]
    }
  ]
}
