*.pyc
*.egg-info/
dist/
build/
*.whl
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

node_modules/
packages/tcip-web/frontend/node_modules/
packages/tcip-web/frontend/dist/
packages/tcip-web/static/

*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
*.log
tensorboard_runs/
