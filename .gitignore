# ── Project data & workspace ─────────────────────────────────────────────
# Projects live in the TCIP workspace (default ~/tcip-projects/) OUTSIDE the repo, so
# they're never tracked. Defensively ignore a workspace or stray data dir if one ever
# lands in the repo tree.
/tcip-projects/
/data/

# ── Review corpus (478-agent review output; evidence for the refactor, ~70MB) ──
/.review-corpus/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.whl
.eggs/

# ── Virtual environments ─────────────────────────────────────────────────
.env
.venv/
env/
venv/

# ── Project runtime state ────────────────────────────────────────────────
.tcip/

# ── Node ─────────────────────────────────────────────────────────────────
node_modules/
# package-lock.json IS committed (reproducible installs + `npm ci` in CI).
*.tsbuildinfo

# ── Frontend build output (keep static assets, ignore generated bundles) ──
packages/tcip-web/static/index.html
packages/tcip-web/static/assets/*.js
packages/tcip-web/static/assets/*.js.map
packages/tcip-web/static/assets/*.css

# ── Retired VS Code extension build output ───────────────────────────────
packages/tcip-vscode/out/

# ── Claude Code config (dev tooling for working on TCIP; not something the shipped ──
# ── platform uses at runtime, so none of it is tracked) ─────────────────────
.claude/

# ── Refactor process docs (current-task/recent-summary/decisions/grounding: dev-process ──
# ── tracking, not something the shipped platform needs) ─────────────────────
/docs/

# ── Editor workspace files ────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── Planning and working documents ───────────────────────────────────────
VISION_AGENT_PLAN.md

# ── Tool / cache directories ────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.testmondata
*.cover
htmlcov/
.coverage

# ── Rust (if agent shell is rebuilt) ─────────────────────────────────────
/tcip-agent/target/

# ── Editor / OS ──────────────────────────────────────────────────────────
*.bak
*.orig
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# ── Model weights & checkpoints (large binaries) ────────────────────────
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
tensorboard_runs/
*.zip
/.review-corpus

# Papers cited in references/: not tracked (redistribution of paywalled PDFs, and size).
# The metadata, quotes, and anchors beside them are tracked and CI-checkable.
references/pdf/
